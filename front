}

void printLine(int width = 58) {
    cout << FG_GRAY;
    for (int i = 0; i < width; i++) cout << "─";
    cout << RESET << "\n";
}

void centerText(const string& text, int width = 58) {
    int padding = (width - (int)text.length()) / 2;
    if (padding > 0) cout << string(padding, ' ');
    cout << text;
}

// Read password with * masking
string readPassword() {
    string password = "";
    char ch;

#ifdef _WIN32
    while ((ch = _getch()) != '\r') {
        if (ch == '\b') {
            if (!password.empty()) {
                password.pop_back();
                cout << "\b \b";
            }
        } else if (ch >= 32) {
            password += ch;
            cout << '*';
        }
    }
#else
    struct termios oldt, newt;
    tcgetattr(STDIN_FILENO, &oldt);
    newt = oldt;
    newt.c_lflag &= ~(ECHO | ICANON);
    tcsetattr(STDIN_FILENO, TCSANOW, &newt);

    while ((ch = getchar()) != '\n' && ch != EOF) {
        if (ch == 127 || ch == '\b') {
            if (!password.empty()) {
                password.pop_back();
                cout << "\b \b";
                cout.flush();
            }
        } else {
            password += ch;
            cout << '*';
            cout.flush();
        }
    }
    tcsetattr(STDIN_FILENO, TCSANOW, &oldt);
#endif

    cout << "\n";
    return password;
}

bool isValidEmail(const string& email) {
    size_t atPos = email.find('@');
    size_t dotPos = email.rfind('.');
    return (atPos != string::npos && dotPos != string::npos &&
            atPos > 0 && dotPos > atPos + 1 && dotPos < email.length() - 1);
}

bool emailExists(const string& email) {
    for (const auto& user : userDatabase) {
        if (user.email == email) return true;
    }
    return false;
}

User* findUser(const string& email) {
    for (auto& user : userDatabase) {
        if (user.email == email) return &user;
    }
    return nullptr;
}

